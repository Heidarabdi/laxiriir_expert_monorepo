{
	"extends": "@repo/typescript-config/base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"target": "ES2023",
		"rewriteRelativeImportExtensions": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
