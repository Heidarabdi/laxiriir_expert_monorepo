{
	"name": "api-ts",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true }); require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"dev": "tsx watch src/app.ts",
		"lint": "biome lint src test drizzle.config.ts vitest.config.ts package.json tsconfig.json tsconfig.build.json",
		"start": "node dist/app.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/autoload": "^6.5.0",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/sensible": "^6.0.4",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"@repo/contracts": "workspace:*",
		"better-auth": "1.7.2",
		"close-with-grace": "^2.5.0",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5",
		"fastify-plugin": "^6.0.0",
		"fastify-type-provider-zod": "^7.0.0",
		"pg": "^8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@electric-sql/pglite": "^0.5.4",
		"@repo/typescript-config": "workspace:^",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.23.1",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
